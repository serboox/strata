#!/bin/bash
# pi on the local Strata model inside a bubblewrap sandbox. The model's commands see the current folder (read-write), a
# read-only system and an empty home: no sudo, no keys or tokens, and no network of its own. What gets out goes over
# sockets to the host: the local Strata server, a read-only gh broker for the repositories of the folder, and a web proxy
# that reaches public addresses only (docs/PI.md).
set -euo pipefail

PORT=${STRATA_PORT:-8080}
AGENT_DIR=${SPI_AGENT_DIR:-$HOME/.pi/agent-local}
CWD=$(pwd -P)

for tool in bwrap socat curl node pi; do
    command -v "$tool" >/dev/null 2>&1 || { echo "spi: $tool is not installed" >&2; exit 1; }
done
NODE_DIR=$(dirname "$(dirname "$(readlink -f "$(command -v node)")")")
case "$(readlink -f "$(command -v pi)")" in
    "$NODE_DIR"/*) ;;
    *) echo "spi: pi is not inside the node prefix $NODE_DIR" >&2; exit 1 ;;
esac

case "$CWD" in
    "$HOME"/*) ;;
    *) echo "spi: start it in a folder inside $HOME, not in $CWD" >&2; exit 1 ;;
esac
first=${CWD#"$HOME"/}
first=${first%%/*}
case "$first" in
    .*) echo "spi: refusing a hidden folder of the home directory ($CWD)" >&2; exit 1 ;;
esac

[ -f "$AGENT_DIR/models.json" ] && [ -f "$AGENT_DIR/settings.json" ] || { echo "spi: $AGENT_DIR needs models.json and settings.json (the local profile)" >&2; exit 1; }
[ -f "$AGENT_DIR/extensions/strata/index.ts" ] || echo "spi: warning: $AGENT_DIR/extensions/strata is missing, pi runs without the loop guard and the cheaper compaction" >&2
mkdir -p "$AGENT_DIR/sessions"
# spi --shell [command]: the same sandbox with a shell (or the command) instead of pi, to see what the model sees
if [ "${1:-}" = "--shell" ]; then
    shift
    RUN=("${@:-bash}")
else
    curl -fsS -m 3 "http://127.0.0.1:$PORT/v1/models" >/dev/null 2>&1 || { echo "spi: no Strata server on port $PORT, start it with bin/strata-serve" >&2; exit 1; }
    RUN=(pi "$@")
fi

SOCK=${XDG_RUNTIME_DIR:-/tmp}/spi-$$.sock
GH_SOCK=${XDG_RUNTIME_DIR:-/tmp}/spi-$$-gh.sock
WEB_SOCK=${XDG_RUNTIME_DIR:-/tmp}/spi-$$-web.sock
WEB_PORT=3128
socat UNIX-LISTEN:"$SOCK",fork,mode=600 TCP:127.0.0.1:"$PORT" &
BRIDGE=$!
GH_BROKER=
WEB_PROXY=
trap 'kill "$BRIDGE" $GH_BROKER $WEB_PROXY 2>/dev/null || true; rm -f "$SOCK" "$GH_SOCK" "$WEB_SOCK"' EXIT
for _ in $(seq 1 30); do [ -S "$SOCK" ] && break; sleep 0.1; done

# gh in the sandbox has no token and no network of its own: a read-only broker on the host answers it over a socket (SPI_GH=0 turns it off)
GH_ARGS=()
SPI_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
if [ "${SPI_GH:-1}" != 0 ]; then
    if [ -f "$SPI_DIR/spi_gh_broker.py" ] && [ -f "$SPI_DIR/spi_gh_shim.py" ] && command -v gh >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
        rm -f "$GH_SOCK"
        python3 -I "$SPI_DIR/spi_gh_broker.py" --socket "$GH_SOCK" --cwd "$CWD" --parent-pid $$ --log "$AGENT_DIR/gh-broker.log" ${SPI_GH_REPOS:+--repos "$SPI_GH_REPOS"} &
        GH_BROKER=$!
        for _ in $(seq 1 30); do [ -S "$GH_SOCK" ] && break; sleep 0.1; done
    fi
    if [ -n "$GH_BROKER" ] && kill -0 "$GH_BROKER" 2>/dev/null && [ -S "$GH_SOCK" ]; then
        GH_ARGS=(--bind "$GH_SOCK" /tmp/gh.sock --ro-bind "$SPI_DIR/spi_gh_shim.py" /tmp/spi-bin/gh)
    else
        echo "spi: warning: the read-only gh broker did not start (needs gh, python3 and spi_gh_broker.py, spi_gh_shim.py next to spi), gh stays without access" >&2
    fi
fi

# the web proxy on the host resolves names itself and refuses loopback, private and VPN-host addresses; it reaches any port but the
# mail ports unless SPI_WEB_PORTS says otherwise. SPI_WEB_VPN=block also refuses the wide public ranges that a VPN routes (CDNs,
# clouds), SPI_WEB_VPN=allow admits every VPN route; SPI_WEB=0 leaves the sandbox without any web access
WEB_ARGS=()
WEB_FLAGS=()
[ -n "${SPI_WEB_VPN:-}" ] && WEB_FLAGS=(--vpn "$SPI_WEB_VPN")
if [ "${SPI_WEB:-1}" != 0 ]; then
    if [ -f "$SPI_DIR/spi_web_proxy.py" ] && command -v python3 >/dev/null 2>&1; then
        rm -f "$WEB_SOCK"
        python3 -I "$SPI_DIR/spi_web_proxy.py" --socket "$WEB_SOCK" --parent-pid $$ --log "$AGENT_DIR/web-proxy.log" ${SPI_WEB_PORTS:+--ports "$SPI_WEB_PORTS"} "${WEB_FLAGS[@]}" &
        WEB_PROXY=$!
        for _ in $(seq 1 30); do [ -S "$WEB_SOCK" ] && break; sleep 0.1; done
    fi
    if [ -n "$WEB_PROXY" ] && kill -0 "$WEB_PROXY" 2>/dev/null && [ -S "$WEB_SOCK" ]; then
        WEB_URL=http://127.0.0.1:$WEB_PORT
        WEB_ARGS=(
            --bind "$WEB_SOCK" /tmp/web.sock
            --setenv HTTP_PROXY "$WEB_URL" --setenv HTTPS_PROXY "$WEB_URL" --setenv http_proxy "$WEB_URL" --setenv https_proxy "$WEB_URL"
            --setenv NO_PROXY "127.0.0.1,localhost,::1" --setenv no_proxy "127.0.0.1,localhost,::1"
            --setenv NODE_USE_ENV_PROXY 1
        )
    else
        echo "spi: warning: the web proxy did not start (needs python3 and spi_web_proxy.py next to spi), the sandbox has no web access" >&2
    fi
fi

ARGS=(
    --die-with-parent --new-session
    --unshare-user --unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup-try --unshare-net
    --cap-drop ALL
    --ro-bind /usr /usr
    --symlink usr/bin /bin --symlink usr/sbin /sbin --symlink usr/lib /lib --symlink usr/lib64 /lib64
    --proc /proc --dev /dev --tmpfs /tmp --tmpfs "$HOME" --tmpfs "$HOME/.cache" --tmpfs "$HOME/.pi/agent"
    --ro-bind "$NODE_DIR" "$NODE_DIR"
    --ro-bind "$AGENT_DIR/models.json" "$HOME/.pi/agent/models.json"
    --ro-bind "$AGENT_DIR/settings.json" "$HOME/.pi/agent/settings.json"
    --bind "$AGENT_DIR/sessions" "$HOME/.pi/agent/sessions"
    --ro-bind-try "$AGENT_DIR/extensions" "$HOME/.pi/agent/extensions"
    --bind "$CWD" "$CWD"
    --bind "$SOCK" /tmp/strata.sock
    --chdir "$CWD"
    --clearenv
    --setenv PATH "/tmp/spi-bin:$NODE_DIR/bin:/usr/local/bin:/usr/bin"
    --setenv HOME "$HOME" --setenv USER "$(id -un)" --setenv LOGNAME "$(id -un)" --setenv SHELL /bin/bash
    --setenv TERM "${TERM:-xterm-256color}" --setenv LANG "${LANG:-C.UTF-8}"
    --setenv PI_OFFLINE 1
)
for f in passwd group nsswitch.conf hosts localtime ssl pki ld.so.cache ld.so.conf ld.so.conf.d alternatives os-release profile profile.d bashrc inputrc; do
    ARGS+=(--ro-bind-try "/etc/$f" "/etc/$f")
done
ARGS+=("${GH_ARGS[@]}" "${WEB_ARGS[@]}")
[ -n "${COLORTERM:-}" ] && ARGS+=(--setenv COLORTERM "$COLORTERM")
# SPI_RO=/path/a:/path/b: more directories, read-only (toolchains the project needs); PATH entries stay yours to set
if [ -n "${SPI_RO:-}" ]; then
    IFS=: read -ra extra <<< "$SPI_RO"
    for dir in "${extra[@]}"; do ARGS+=(--ro-bind "$dir" "$dir"); done
fi

# a git hook or the repository config written by the model would run later on the host, outside the sandbox
if [ -d "$CWD/.git" ]; then
    [ -d "$CWD/.git/hooks" ] && ARGS+=(--ro-bind "$CWD/.git/hooks" "$CWD/.git/hooks")
    [ -f "$CWD/.git/config" ] && ARGS+=(--ro-bind "$CWD/.git/config" "$CWD/.git/config")
fi
# everything above the folder is read-only too: the directories on the way down are empty and cannot be written
ARGS+=(--remount-ro "$HOME" --remount-ro /)

# pi and what the model runs (builds, tests) go in a control group of their own with a low CPU and I/O weight, so they yield to
# the programs the person is using; SPI_PRIORITY=normal leaves the priority alone. The weight must really show up in the group:
# a scope can start and still have its weights ignored when the controllers are not delegated to the user manager.
priority_scope_applies() {
    command -v systemd-run >/dev/null 2>&1 || return 1
    local weight
    weight=$(timeout 10 systemd-run --user --scope --quiet -p CPUWeight=20 -p IOWeight=20 -- sh -c 'cat "/sys/fs/cgroup$$(cut -d: -f3 /proc/self/cgroup)/cpu.weight"' 2>/dev/null) || return 1
    [ "$weight" = 20 ]
}
PRIORITY_CMD=()
if [ "${SPI_PRIORITY:-background}" != normal ]; then
    if priority_scope_applies; then
        PRIORITY_CMD=(systemd-run --user --scope --quiet -p CPUWeight=20 -p IOWeight=20 --)
    else
        echo "spi: warning: no control group with a low CPU weight is available here, pi and its commands keep the normal priority" >&2
    fi
fi

status=0
# --new-session leaves the sandbox without a controlling terminal, so the kernel never sends it SIGWINCH: the window
# size is polled through the inherited terminal (fd 3) and a change is forwarded to the program by hand
INNER='exec 3<&0
socat TCP-LISTEN:'"$PORT"',bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/tmp/strata.sock &
[ -S /tmp/web.sock ] && socat TCP-LISTEN:'"$WEB_PORT"',bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/tmp/web.sock &
if [ -t 3 ]; then
    pid=$$
    (
        last=$(stty size <&3 2>/dev/null)
        while kill -0 "$pid" 2>/dev/null; do
            sleep 0.2
            now=$(stty size <&3 2>/dev/null)
            [ "$now" = "$last" ] || { last=$now; kill -WINCH "$pid" 2>/dev/null; }
        done
    ) &
fi
exec "$@" 3<&-'
BWRAP_ARGS=("${ARGS[@]}" /bin/sh -c "$INNER" sh "${RUN[@]}")
if [ "${#PRIORITY_CMD[@]}" -gt 0 ]; then
    # systemd-run reads a $ in its arguments as the start of a variable and $$ as one literal dollar, so every dollar is doubled
    for i in "${!BWRAP_ARGS[@]}"; do BWRAP_ARGS[i]=${BWRAP_ARGS[i]//\$/\$\$}; done
fi
"${PRIORITY_CMD[@]}" bwrap "${BWRAP_ARGS[@]}" || status=$?
exit "$status"
